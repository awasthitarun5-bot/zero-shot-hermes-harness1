# UP Police Data Analyst Agent — environment.
# Copy to .env and set values. .env is gitignored and is the ONLY manual setup step.

# --- LLM (required) ---
AGENT_LLM_PROVIDER=anthropic
AGENT_LLM_MODEL=claude-3-5-sonnet-20240620
AGENT_ANTHROPIC_API_KEY=

# --- Database ---
# Use the ODBC connection-string format for MsSQL, e.g.:
#   mssql+pyodbc://user:pass@host:1433/UPPolice?driver=ODBC+Driver+18+for+SQL+Server
# For local SQLite dev fallback:
#   sqlite:///./data/app.db
AGENT_DATABASE_URL=sqlite:///./data/app.db

# Optional: extra connection args passed to pyodbc
# AGENT_MSSQL_EXTRA_PARAMS=TrustServerCertificate=yes;Encrypt=optional

# --- Server ---
PORT=8001
AGENT_LOG_LEVEL=INFO
